{
  "name": "site-kit-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm -r test",
    "scrub": "node scripts/scrub.mjs",
    "credits": "pnpm --filter @rcweston/credits run self-check",
    "check": "pnpm scrub && pnpm build && pnpm typecheck && pnpm test && pnpm credits"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "tsx": "4.20.6",
    "typescript": "~5.9.3"
  }
}
