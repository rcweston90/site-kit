# Settings for the site. Copy this file to .env.local (or set the same
# variables on your host) and fill in what you need. Every one is optional
# under `pnpm dev`; a production server needs the two sign-in settings.
# lib/config.ts reads them all.
#
#   cp env.example .env.local


# ── Sign-in ──────────────────────────────────────────────────────────────
# The passcode for /admin. Under `pnpm dev` it defaults to `studio`.
SITE_KIT_ADMIN_PASSCODE=

# Signs the session cookie: 32 or more random characters. Make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or `openssl rand -hex 32`. Changing it signs everyone out. Under `pnpm dev`
# a new one is made at each start.
SITE_KIT_SESSION_SECRET=


# ── Where the site lives ─────────────────────────────────────────────────
# The public address, for metadata and shared links. Set it for the build
# as well as for the server. Default http://localhost:3000.
SITE_KIT_SITE_URL=


# ── Stories and settings ─────────────────────────────────────────────────
# Left empty, the site keeps everything in an embedded Postgres (PGlite) in
# .data/pglite, which lasts across restarts. One server process at a time
# may open it.
#
# Set a Postgres connection string to use a hosted database instead: Neon,
# Supabase, Vercel Postgres, RDS or your own. Use the pooled address your
# host gives for serverless functions, and add ?sslmode=require when it asks.
# It starts postgres:// (or postgresql://) and holds the user, password,
# host, port and database name.
SITE_KIT_DATABASE_URL=

# Connections each server instance keeps open. Default 10; on serverless
# hosts, where every instance opens its own, 1 to 3 is kinder to the database.
SITE_KIT_DATABASE_POOL_SIZE=

# Migrations run on first use (they take a lock, so several instances
# starting at once is fine). Set to false to run them yourself:
#   pnpm db:migrate             (from the repo root, or apps/demo)
#   pnpm db:migrate --dry-run
SITE_KIT_AUTO_MIGRATE=

# Write the sample stories (Fieldnote Studio) into an empty store. Set to
# false to start with nothing.
SITE_KIT_SEED=

# The folder for the embedded database and local uploads. Default .data
# (inside apps/demo; ignored by git).
SITE_KIT_DATA_DIR=

# `memory` keeps everything in memory, lost on restart. For tests and quick
# looks; leave empty otherwise.
SITE_KIT_STORAGE=


# ── Uploads ──────────────────────────────────────────────────────────────
# Left empty, uploads are saved on disk in .data/media. Serverless hosts
# throw their disk away, so there, set all four of the S3 settings below.
# Any S3-compatible service works: AWS S3, Cloudflare R2, MinIO, and others.
# The site serves the files itself, so the bucket can stay private.
SITE_KIT_MEDIA_DIR=

# The service's address, e.g. https://s3.us-east-1.amazonaws.com, or the S3 API
# address your R2 or MinIO dashboard shows.
SITE_KIT_S3_ENDPOINT=
SITE_KIT_S3_BUCKET=
SITE_KIT_S3_ACCESS_KEY_ID=
SITE_KIT_S3_SECRET_ACCESS_KEY=
# Your bucket's region on AWS. Default `auto`, which R2 expects.
SITE_KIT_S3_REGION=
