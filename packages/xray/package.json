{
  "name": "@rcweston/xray",
  "version": "0.1.0",
  "description": "An on-page inspector for spacing, type, tokens and accessibility, measured on the live page against your own rhythm.",
  "license": "MIT",
  "author": "Charlie Weston",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "inspector",
    "design-tools",
    "spacing",
    "baseline-grid",
    "design-tokens",
    "accessibility",
    "devtools"
  ],
  "peerDependencies": {
    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19"
  },
  "dependencies": {
    "lucide-react": "~0.562.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'test/*.test.ts'"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
